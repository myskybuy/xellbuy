generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  image String
}

model Product {
  id          Int        @id @default(autoincrement())
  name        String
  category    String
  brand       String
  price       Int
  salePrice   Int
  image       String
  stock       Int
  description String     @db.Text
  careInfo    String     @default("") @db.Text
  occasion    String     @default("")
  wishlists   Wishlist[]
  reviews     Review[]
}

model Coupon {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  type     String
  value    Int
  minOrder Int       @default(0)
  active   Boolean   @default(true)
  expiry   DateTime?
}

model Banner {
  id         Int     @id @default(1)
  active     Boolean @default(false)
  title      String  @default("")
  subtitle   String  @default("")
  image      String  @default("")
  buttonText String  @default("Shop Now")
  buttonLink String  @default("/shop")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String   @default("")
  address      String   @default("") @db.Text
  passwordHash String
  createdAt    DateTime @default(now())
  orders       Order[]
  wishlists    Wishlist[]
  reviews      Review[]
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  email     String
  codeHash  String
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model Order {
  id                Int      @id @default(autoincrement())
  userId            Int?
  user              User?    @relation(fields: [userId], references: [id])
  items             Json
  customerName      String
  phone             String
  address           String   @db.Text
  email             String   @default("")
  subtotal          Int
  couponCode        String   @default("")
  discount          Int      @default(0)
  total             Int
  paymentMethod     String   @default("COD")
  paymentStatus     String   @default("pending")
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            String   @default("Pending")
  createdAt         DateTime @default(now())
}
